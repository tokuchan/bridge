PROJECT_NAME           = "bridge"
PROJECT_NUMBER           = @PROJECT_VERSION@
PROJECT_BRIEF           = "Bridge the gaps between C++ standards, compilers, and STL implementations."
OUTPUT_DIRECTORY        = @CMAKE_BINARY_DIR@/docs

INPUT                    = @CMAKE_SOURCE_DIR@/include
RECURSIVE                = YES
FILE_PATTERNS            = *.hpp *.h

# The mainpage and every conceptual-division page (docs/adr/0014-
# documentation-site-architecture.md) live here as hand-written +
# generated-block Markdown, not README.md -- no USE_MDFILE_AS_MAINPAGE
# needed, since docs/pages/index.md declares \mainpage itself.
INPUT                   += @CMAKE_SOURCE_DIR@/docs/pages
FILE_PATTERNS            += *.md

# CONTEXT.md and every ADR fold into the generated site as-is (docs/
# adr/0014's amendment) -- no \page directive injected into either, so
# both stay 100% plain, portable Markdown: identical rendering here
# and on GitHub, where ADRs are explicitly also meant to be read.
# Doxygen auto-titles/auto-IDs a page from its file path when no
# \page command is present.
INPUT                   += @CMAKE_SOURCE_DIR@/CONTEXT.md
INPUT                   += @CMAKE_SOURCE_DIR@/docs/adr

# EXTRACT_ALL=YES would suppress WARN_IF_UNDOCUMENTED entirely (Doxygen
# treats "extract everything anyway" and "warn about undocumented entities"
# as mutually exclusive). NO is required for undocumented entities to
# actually produce a warning instead of being silently backfilled.
EXTRACT_ALL              = NO
EXTRACT_PRIVATE          = NO
EXTRACT_STATIC           = YES

# Full documentation coverage is a project requirement — every undocumented
# entity fails the build, not just warns.
WARN_IF_UNDOCUMENTED     = YES
WARN_IF_INCOMPLETE_DOC   = YES
WARN_NO_PARAMDOC         = YES
WARN_AS_ERROR            = FAIL_ON_WARNINGS

# Without this, code that only exists via a macro invocation (e.g. Rivets'
# Layer-2 Named Detectors, generated by BRIDGE_RIVETS_DEFINE_DETECTOR) is
# invisible to Doxygen — it never expands macro *uses*, only documents
# macro *definitions* by default — so those generated functions would be
# silently absent from the docs instead of failing the undocumented-entity
# gate above. Expanding only the specific generator macros (not every
# macro, which would explode into expanding std library internals too)
# keeps generated entities visible to the same coverage gate as hand-written
# ones.
MACRO_EXPANSION          = YES
EXPAND_ONLY_PREDEF       = YES
EXPAND_AS_DEFINED        = BRIDGE_RIVETS_DEFINE_DETECTOR \
                            BRIDGE_RIVETS_DEFINE_DETECTOR_RANGE

GENERATE_HTML            = YES
GENERATE_LATEX           = NO
GENERATE_MAN             = NO
# scripts/docs-pages.py (docs/adr/0014) reads this to pull each promoted
# symbol's real @brief text into the generated per-facility tables --
# the same text WARN_IF_UNDOCUMENTED already enforces exists, so those
# tables can't drift from the real docs the way a hand-duplicated brief
# in the registry could.
GENERATE_XML             = YES

QUIET                    = YES

# Doxygen Awesome theme (third_party/doxygen-awesome-css, pinned at
# v2.4.2 -- docs/adr/0014), for a cppreference-closer look: sidebar
# navigation, dark mode, cleaner typography. HTML_COLORSTYLE=LIGHT
# disables Doxygen's own native dark-mode toggle so the theme's own
# toggle (wired via docs/doxygen-header.html) is the only one, not two
# competing buttons.
GENERATE_TREEVIEW        = YES
DISABLE_INDEX            = NO
FULL_SIDEBAR             = NO
HTML_COLORSTYLE          = LIGHT
HTML_HEADER              = @CMAKE_SOURCE_DIR@/docs/doxygen-header.html
HTML_EXTRA_STYLESHEET    = @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome.css \
                           @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
                           @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES         = @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                           @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                           @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                           @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-interactive-toc.js \
                           @CMAKE_SOURCE_DIR@/third_party/doxygen-awesome-css/doxygen-awesome-tabs.js
